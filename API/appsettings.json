{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "data": "Data Source=payment.db;Cache=Shared"
  },
  "AllowedHosts": "*",
  "PaymentGateway": {
    "Provider": "Simulation",
    "SimulationSuccessRate": 90,
    "RefundSuccessRate": 95,
    "TimeoutSeconds": 30,
    "Stripe": {
      "ApiKey": "sk_test_YOUR_KEY_HERE",
      "Endpoint": "https://api.stripe.com/v1"
    },
    "PayPal": {
      "ClientId": "YOUR_CLIENT_ID",
      "ClientSecret": "YOUR_CLIENT_SECRET",
      "Endpoint": "https://api.sandbox.paypal.com"
    },
    "iyzipay": {
      "ApiKey": "YOUR_API_KEY",
      "SecretKey": "YOUR_SECRET_KEY",
      "Endpoint": "https://sandbox-api.iyzipay.com"
    }
  },
  "Security": {
    "RequireHttps": true,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://yourdomain.com"
    ]
  }
}